{
  "manifest_version": 3,
  "name": "LinkedIn Paste Guard",
  "version": "1.0",

  "permissions": [
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/modal.js",
        "content/content.js"
      ],
      "css": [
        "content/modal.css"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "content/modal.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}